# AION2-KINA Docker Environment
# Copy to .env and fill in actual values
# Full credential reference: GUIDE/CREDENTIALS.md

X_LOCAL_EXPLORER=false
WRANGLER_WRITE_LOGS=false
ADMIN_AUTH_SECRET=<from-CREDENTIALS>
ADMIN_PASSWORD_HASH=<from-CREDENTIALS>
ANALYTICS_PSEUDONYM_KEY=<from-CREDENTIALS>
ANALYTICS_IP_ENCRYPTION_KEY=<from-CREDENTIALS>
SITE_URL=https://www.aion2kina.com
ADMIN_API_KEY=<from-CREDENTIALS>
